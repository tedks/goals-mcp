load("@aspect_rules_js//js:defs.bzl", "js_library")

package(default_visibility = ["//visibility:private"])

js_library(
    name = "client",
    srcs = ["client.ts"],
    visibility = ["//:__pkg__"],
)

js_library(
    name = "server",
    srcs = ["server.ts"],
    visibility = ["//:__pkg__"],
    deps = [
        ":client",
        "//src/agent:contract",
        "//src/agent:schemas",
    ],
)

js_library(
    name = "stdio",
    srcs = ["stdio.ts"],
    visibility = ["//:__pkg__"],
    deps = [
        ":client",
        ":server",
    ],
)
